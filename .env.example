# Copy to .env.local for local dev with `vercel dev`, and set the same vars in
# your Vercel project (Settings → Environment Variables) for production.

# Required — your Groq API key (free at console.groq.com). Powers A.R.I.A.
# This is the same kind of key you use for Nomo; you can reuse it.
GROQ_API_KEY=gsk_...

# Optional — enables A.R.I.A to actually email you contact messages (resend.com).
# Without it, messages are logged server-side and A.R.I.A still confirms receipt.
RESEND_API_KEY=
